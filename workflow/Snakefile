# Snakefile — Plasmodium long-amplicon speciation pipeline.
#
# Phases 1–3 only at this checkpoint (HANDOFF.md Step 3). Phase 4 (cross-
# marker resolution) and Phase 5 (Quarto report) are added in later steps.

configfile: "workflow/config.yaml"

include: "rules/01_blast.smk"
include: "rules/02_cross_species.smk"
include: "rules/03_alignment.smk"
include: "rules/04_resolution.smk"
include: "rules/05_report.smk"
include: "rules/06_entropy_audit.smk"
include: "rules/07_threshold_sensitivity.smk"

OUT     = config["paths"]["outputs"]
REPORTS = config["paths"]["reports"]
MARKERS = config["markers"]


def _final_targets():
    t = []
    # Phase 1 — self-BLAST tables.
    t += [f"{OUT}/blast/self_blast_{m}.tsv" for m in MARKERS]
    # Phase 2 — cross-species + length QC.
    t += [f"{OUT}/cross_species/18S_acc_to_header.tsv"]
    t += [f"{OUT}/cross_species/{m}_suspicious.tsv"      for m in MARKERS]
    t += [f"{OUT}/cross_species/{m}_closest_per_seq.tsv" for m in MARKERS]
    t += [f"{OUT}/qc/{m}_lengths.tsv"                    for m in MARKERS]
    t += [f"{OUT}/qc/{m}_length_classification.tsv"      for m in MARKERS]
    # Phase 3 — alignments + entropy + figures.
    t += [f"{OUT}/alignment/ma_{m}.target.fasta"         for m in MARKERS]
    for m in MARKERS:
        for kind in ("per_position", "windows", "primer_candidates",
                     "interior_candidates", "core_bounds"):
            t.append(f"{OUT}/entropy/{m}.{kind}.tsv")
    for m in MARKERS:
        for plot in ("entropy_vs_position", "coverage_vs_position"):
            for ext in ("png", "svg"):
                t.append(f"{REPORTS}/figures/{m}_{plot}.{ext}")
    # Phase 4 — extension targets.
    t += [f"{OUT}/cross_species/{m}_pair_summary.tsv" for m in MARKERS]
    t += [
        f"{OUT}/cross_species/18S_suspicious_loose.tsv",
        f"{OUT}/cross_species/18S_species_coverage.tsv",
        f"{OUT}/cross_species/resolution_table.tsv",
    ]
    # Phase 5 — Quarto book.
    t += [f"{REPORTS}/_book/index.html"]
    return t


FINAL_TARGETS = _final_targets()


rule all:
    input:
        FINAL_TARGETS,
